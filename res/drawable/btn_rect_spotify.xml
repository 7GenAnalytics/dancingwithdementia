<?xml version="1.0" encoding="utf-8"?>
<!-- Build 42: rounded-rectangle version of btn_circle_spotify (same green), for the larger bottom-row Music button. -->
<!-- Build 42 (revised): muted sage green instead of bright Spotify green, so it reads as clearly different from, and quieter than, the green Play button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#3C6549" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#2a2f38" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#5F9A76"
                android:endColor="#4B7D5E"
                android:angle="270" />
        </shape>
    </item>
</selector>
