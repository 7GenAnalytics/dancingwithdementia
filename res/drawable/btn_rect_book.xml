<?xml version="1.0" encoding="utf-8"?>
<!-- Build 42: rounded-rectangle version of btn_circle_book (same warm brown), for the larger bottom-row Audiobook button. -->
<!-- Build 42 (revised): muted brown, softer than the original book colour, so the Play and Stop buttons stand out more. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#5C4636" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#2a2f38" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#8E7058"
                android:endColor="#735843"
                android:angle="270" />
        </shape>
    </item>
</selector>
