<?xml version="1.0" encoding="utf-8"?>
<!-- Audiobook button - a warm, book-ish brown so it reads as a distinct
     content type from the green Spotify (music) button next to it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#6B4A2A" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#2a2f38" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#B5793E"
                android:endColor="#8A5A2B"
                android:angle="270" />
        </shape>
    </item>
</selector>
